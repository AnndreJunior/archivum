SESSION_DRIVER=memory

# Admin (não é usado nos testes, mas as variáveis precisam existir para validar o env)
ADMIN_NOME=Administrador do Sistema
ADMIN_MATRICULA=ADM001
ADMIN_EMAIL=admin@archivum.test
ADMIN_SENHA=admin-test-123

# Database (substituídos em runtime pelo container iniciado via testcontainers)
DB_HOST=localhost
DB_PORT=5432
DB_USER=archivum
DB_PASSWORD=archivum
DB_DATABASE=archivum_test

# Mail (substituídos em runtime pelo container smtp4dev via testcontainers)
MAIL_MAILER=smtp
MAIL_FROM_NAME=Archivum
MAIL_FROM_ADDRESS=noreply@archivum.test
SMTP_HOST=localhost
SMTP_PORT=2525
