# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Admin (bibliotecário admin criado no startup, caso não exista)
ADMIN_NOME=Administrador do Sistema
ADMIN_MATRICULA=ADM001
ADMIN_EMAIL=admin@archivum.local
ADMIN_SENHA=troque-por-uma-senha-forte

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=archivum
DB_PASSWORD=
DB_DATABASE=archivum

# Mail (SMTP — smtp4dev em desenvolvimento)
MAIL_MAILER=smtp
MAIL_FROM_NAME=Archivum
MAIL_FROM_ADDRESS=noreply@archivum.local
SMTP_HOST=localhost
SMTP_PORT=2525
