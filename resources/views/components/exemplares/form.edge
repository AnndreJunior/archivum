{{--
  Partial do formulário de exemplar.

  Props:
  acao      - URL de submissão (formAttributes(...).action). Quando o método
  não é GET/POST, o _method já vem na query string.
  metodo    - Método HTML do formulário (formAttributes(...).method).
  livros    - Livros disponíveis para o modal, no formato
  { id, titulo, isbn, autores }.
  exemplar  - Exemplar sendo editado (opcional).
--}}
@let(acao = $props.get('acao'))
@let(metodo = $props.get('metodo'))
@let(livros = $props.get('livros') ?? [])
@let(exemplar = $props.get('exemplar'))
@let(selecionadoInicial = old('livroId', exemplar ? exemplar.livroId : ''))
@let(situacaoAtual = old('situacao', exemplar ? exemplar.situacao : 'disponivel'))

<div
  x-data="seletorLivros({
    livrosIniciais: {{ JSON.stringify(livros) }},
    selecionadoInicial: {{ JSON.stringify(selecionadoInicial) }}
    })"
>
  <form action="{{ acao }}" method="{{ metodo ?? 'post' }}" class="space-y-5">
    {{ csrfField() }}
    <div>
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <span class="block text-sm font-medium text-gray-900">Livro</span>
          <span class="text-xs text-gray-500">Selecione a obra à qual este exemplar pertence.</span>
        </div>

        <button
          type="button"
          @click="abrir()"
          class="inline-flex items-center justify-center gap-2 rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50"
        >
          @svg('lucide:library', { class: 'h-4 w-4' })
          
          Selecionar livro

        </button>
      </div>

      <input type="hidden" name="livroId" value="{{ selecionadoInicial }}" x-model="selecionado" />

      <div class="mt-3 rounded-md border border-gray-200 bg-gray-50 p-3">
        <template x-if="livroSelecionado">
          <div class="flex flex-col gap-1">
            <span class="text-sm font-medium text-gray-900" x-text="livroSelecionado.titulo"></span>
            <span class="text-xs text-gray-500" x-text="livroSelecionado.isbn || 'Sem ISBN'"></span>
            <span
              class="text-xs text-gray-500"
              x-text="livroSelecionado.autores.length > 0
                ? livroSelecionado.autores.join(', ')
                : 'Sem autores'"
            ></span>
          </div>
        </template>
        <span x-show="!livroSelecionado" class="text-sm text-gray-500">
          Nenhum livro selecionado.
        </span>
      </div>
      @inputError('livroId')
        @each(message in $messages)
          <p class="mt-1 text-sm text-red-600">{{ message }}</p>
        @end
      @end
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <label for="codigo" class="block text-sm font-medium text-gray-900">Código / tombo</label>
        <input
          type="text"
          id="codigo"
          name="codigo"
          value="{{ old('codigo', exemplar ? exemplar.codigo : '') }}"
          maxlength="30"
          required
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/30"
        />
        @inputError('codigo')
          @each(message in $messages)
            <p class="mt-1 text-sm text-red-600">{{ message }}</p>
          @end
        @end
      </div>

      <div>
        <label for="situacao" class="block text-sm font-medium text-gray-900">Situação</label>
        <select
          id="situacao"
          name="situacao"
          class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/30"
        >
          <option value="disponivel" {{ situacaoAtual === 'disponivel' ? 'selected' : '' }}>
            Disponível
          </option>
          <option value="emprestado" {{ situacaoAtual === 'emprestado' ? 'selected' : '' }}>
            Emprestado
          </option>
          <option value="extraviado" {{ situacaoAtual === 'extraviado' ? 'selected' : '' }}>
            Extraviado
          </option>
          <option value="danificado" {{ situacaoAtual === 'danificado' ? 'selected' : '' }}>
            Danificado
          </option>
        </select>
        @inputError('situacao')
          @each(message in $messages)
            <p class="mt-1 text-sm text-red-600">{{ message }}</p>
          @end
        @end
      </div>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <button
        type="submit"
        class="inline-flex items-center gap-2 rounded-md bg-brand px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand/90"
      >
        @svg('lucide:check', { class: 'h-4 w-4' })
        
        Salvar

      </button>
      <a
        href="{{ route('exemplares.index') }}"
        class="text-sm font-medium text-gray-600 hover:text-gray-900"
      >
        Cancelar
      </a>
    </div>
  </form>

  <div
    x-show="aberto"
    x-cloak
    class="fixed inset-0 z-50 overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-labelledby="titulo-modal-livros"
    @keydown.escape.window="fechar()"
  >
    <div class="fixed inset-0 bg-gray-900/50" @click="fechar()"></div>

    <div class="relative mx-auto mt-16 w-full max-w-lg px-4">
      <div class="rounded-xl border border-gray-200 bg-white shadow-xl">
        <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4">
          <h2 id="titulo-modal-livros" class="text-lg font-semibold text-gray-900">
            Selecionar livro
          </h2>

          <button
            type="button"
            @click="fechar()"
            class="cursor-pointer rounded-md p-1 text-gray-500 hover:bg-gray-100 hover:text-gray-700"
            aria-label="Fechar"
          >
            @svg('lucide:x', { class: 'h-5 w-5' })
          </button>
        </div>

        <div class="px-6 py-5">
          <label for="busca-livros" class="block text-sm font-medium text-gray-900">
            Pesquisar livro
          </label>
          <input
            type="text"
            id="busca-livros"
            x-model="busca"
            x-ref="busca"
            placeholder="Digite o título, ISBN ou autor"
            class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/30"
          />

          <div class="mt-3 max-h-72 overflow-y-auto rounded-md border border-gray-200">
            <template x-for="livro in livrosFiltrados" :key="livro.id">
              <label
                class="flex cursor-pointer items-start gap-3 border-b border-gray-100 px-3 py-2.5 text-sm text-gray-800 last:border-b-0 hover:bg-gray-50"
              >
                <input
                  type="radio"
                  name="livro-modal"
                  class="mt-0.5 h-4 w-4 border-gray-300 text-brand focus:ring-brand/30"
                  :checked="selecionado === livro.id"
                  @change="selecionar(livro.id)"
                />
                <span class="flex flex-col gap-0.5">
                  <span class="font-medium" x-text="livro.titulo"></span>
                  <span class="text-xs text-gray-500" x-text="livro.isbn || 'Sem ISBN'"></span>
                  <span
                    class="text-xs text-gray-500"
                    x-text="livro.autores.length > 0 ? livro.autores.join(', ') : 'Sem autores'"
                  ></span>
                </span>
              </label>
            </template>

            <p
              x-show="livrosFiltrados.length === 0"
              class="px-3 py-8 text-center text-sm text-gray-500"
            >
              Nenhum livro encontrado.
            </p>
          </div>

          <div
            class="mt-5 flex flex-col-reverse gap-3 border-t border-gray-200 pt-4 sm:flex-row sm:items-center sm:justify-end"
          >
            <button
              type="button"
              @click="fechar()"
              class="inline-flex items-center justify-center gap-2 rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50"
            >
              Cancelar
            </button>
            <button
              type="button"
              @click="fechar()"
              class="inline-flex items-center justify-center gap-2 rounded-md bg-brand px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand/90"
            >
              @svg('lucide:check', { class: 'h-4 w-4' })
              
              Concluir

            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
