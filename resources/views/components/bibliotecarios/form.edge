{{--
  Partial do formulário de bibliotecário.

  Props:
  acao          - URL de submissão (formAttributes(...).action). Quando o método
  não é GET/POST, o _method já vem na query string do action.
  metodo        - Método HTML do formulário (formAttributes(...).method).
  bibliotecario - Bibliotecário sendo editado (opcional).
--}}
@let(bibliotecario = $props.get('bibliotecario'))
@let(acao = $props.get('acao'))
@let(metodo = $props.get('metodo'))

<form action="{{ acao }}" method="{{ metodo ?? 'post' }}" class="space-y-5">
  {{ csrfField() }}
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <label for="nome" class="block text-sm font-medium text-gray-900">Nome</label>
      <input
        type="text"
        id="nome"
        name="nome"
        value="{{ old('nome', bibliotecario ? bibliotecario.nome : '') }}"
        maxlength="120"
        required
        autofocus
        class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/30"
      />
      @inputError('nome')
        @each(message in $messages)
          <p class="mt-1 text-sm text-red-600">{{ message }}</p>
        @end
      @end
    </div>

    <div>
      <label for="matricula" class="block text-sm font-medium text-gray-900">Matrícula</label>
      <input
        type="text"
        id="matricula"
        name="matricula"
        value="{{ old('matricula', bibliotecario ? bibliotecario.matricula : '') }}"
        minlength="6"
        maxlength="6"
        required
        class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/30"
      />
      @inputError('matricula')
        @each(message in $messages)
          <p class="mt-1 text-sm text-red-600">{{ message }}</p>
        @end
      @end
    </div>

    <div>
      <label for="email" class="block text-sm font-medium text-gray-900">E-mail</label>
      <input
        type="email"
        id="email"
        name="email"
        value="{{ old('email', bibliotecario ? bibliotecario.email : '') }}"
        maxlength="254"
        required
        class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/30"
      />
      @inputError('email')
        @each(message in $messages)
          <p class="mt-1 text-sm text-red-600">{{ message }}</p>
        @end
      @end
    </div>

    <div class="sm:col-span-2">
      <label for="role" class="block text-sm font-medium text-gray-900">Perfil</label>
      <select
        id="role"
        name="role"
        required
        class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/30"
      >
        <option value="">Selecione</option>
        <option
          value="bibliotecario"
          {{
            old('role', bibliotecario ? bibliotecario.role : '') === 'bibliotecario'
              ? 'selected'
              : ''
          }}
        >
          Bibliotecário
        </option>
        <option
          value="admin"
          {{
            old('role', bibliotecario ? bibliotecario.role : '') === 'admin'
              ? 'selected'
              : ''
          }}
        >
          Administrador
        </option>
      </select>
      <p class="mt-1 text-xs text-gray-500">
        Administradores gerenciam os usuários e também podem desativar alunos.
      </p>
      @inputError('role')
        @each(message in $messages)
          <p class="mt-1 text-sm text-red-600">{{ message }}</p>
        @end
      @end
    </div>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <button
      type="submit"
      class="inline-flex items-center gap-2 rounded-md bg-brand px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand/90"
    >
      @svg('lucide:check', { class: 'h-4 w-4' })
      Salvar
    </button>
    <a
      href="{{ route('bibliotecarios.index') }}"
      class="text-sm font-medium text-gray-600 hover:text-gray-900"
    >
      Cancelar
    </a>
  </div>
</form>
