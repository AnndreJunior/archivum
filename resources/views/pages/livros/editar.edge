@layouts.app({ title: 'Editar livro — Archivum', active: 'livros' })
  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold text-gray-900">Editar livro</h1>
    <p class="mt-1 text-sm text-gray-600">Atualize os dados de {{ livro.titulo }}.</p>

    <div class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      @let(formEditar = formAttributes('livros.update', { id: livro.id }))
      @!livros.form({
        acao: formEditar.action,
        metodo: formEditar.method,
        livro: livro,
        autores: autores,
        selecionadosIniciais: selecionadosIniciais,
      })
    </div>
  </div>
@end
