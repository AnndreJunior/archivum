@layouts.app({ title: 'Novo livro — Archivum', active: 'livros' })
  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold text-gray-900">Novo livro</h1>
    <p class="mt-1 text-sm text-gray-600">Cadastre uma obra e selecione os seus autores.</p>

    <div class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      @let(formCriar = formAttributes('livros.store'))
      @!livros.form({
        acao: formCriar.action,
        metodo: formCriar.method,
        autores: autores,
      })
    </div>
  </div>
@end
