@layouts.app({ title: 'Exemplares — Archivum', active: 'exemplares' })
  @let(rotulosSituacao = {
    disponivel: 'Disponível',
    emprestado: 'Emprestado',
    extraviado: 'Extraviado',
    danificado: 'Danificado',
  })
  @let(classesSituacao = {
    disponivel: 'bg-green-100 text-green-700',
    emprestado: 'bg-blue-100 text-blue-700',
    extraviado: 'bg-amber-100 text-amber-700',
    danificado: 'bg-red-100 text-red-700',
  })

  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Exemplares</h1>
      <p class="mt-1 text-sm text-gray-600">
        Gerencie as cópias físicas disponíveis no acervo da biblioteca.
      </p>
    </div>

    <a
      href="{{ route('exemplares.create') }}"
      class="inline-flex items-center gap-2 rounded-md bg-brand px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand/90"
    >
      @svg('lucide:copy-plus', { class: 'h-4 w-4' })
      Novo exemplar
    </a>
  </div>

  @flashMessage('sucesso')
    <div
      class="mt-6 flex items-start gap-3 rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-700"
    >
      @svg('lucide:circle-check', { class: 'mt-0.5 h-4 w-4 shrink-0' })
      <span>{{ $message }}</span>
    </div>
  @end

  @flashMessage('erro')
    <div
      class="mt-6 flex items-start gap-3 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700"
    >
      @svg('lucide:circle-alert', { class: 'mt-0.5 h-4 w-4 shrink-0' })
      <span>{{ $message }}</span>
    </div>
  @end

  <form action="{{ route('exemplares.index') }}" method="get" class="mt-6 flex items-center gap-2">
    <input
      type="search"
      name="busca"
      value="{{ busca }}"
      placeholder="Buscar por código, título, ISBN ou autor"
      class="block w-full max-w-sm rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/30"
    />
    <button
      type="submit"
      class="inline-flex items-center gap-2 rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50"
    >
      @svg('lucide:search', { class: 'h-4 w-4' })
      Buscar
    </button>
  </form>

  <div class="mt-6 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-4 py-3">Código</th>
          <th class="px-4 py-3">Livro</th>
          <th class="px-4 py-3">Autores</th>
          <th class="px-4 py-3">Situação</th>
          <th class="px-4 py-3 text-right">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        @each(exemplar in exemplares)
          <tr>
            <td class="px-4 py-3 font-medium text-gray-900">{{ exemplar.codigo }}</td>
            <td class="px-4 py-3">
              <div class="font-medium text-gray-900">{{ exemplar.livro.titulo }}</div>
              <div class="text-xs text-gray-500">{{ exemplar.livro.isbn || 'Sem ISBN' }}</div>
            </td>
            <td class="px-4 py-3">
              @if(exemplar.livro.autores.length > 0)
                <div class="flex flex-wrap gap-1">
                  @each(autor in exemplar.livro.autores)
                    <span
                      class="inline-flex rounded-full bg-brand/10 px-2.5 py-0.5 text-xs font-medium text-brand"
                    >
                      {{ autor.nome }}
                    </span>
                  @end
                </div>
              @else
                <span class="text-gray-500">—</span>
              @end
            </td>
            <td class="px-4 py-3">
              <span
                class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium {{ classesSituacao[exemplar.situacao] || 'bg-gray-100 text-gray-600' }}"
              >
                {{ rotulosSituacao[exemplar.situacao] || exemplar.situacao }}
              </span>
            </td>
            <td class="px-4 py-3">
              <div class="flex items-center justify-end gap-3">
                <a
                  href="{{ route('exemplares.edit', { id: exemplar.id }) }}"
                  class="inline-flex items-center gap-1 font-medium text-brand hover:underline"
                >
                  @svg('lucide:pen-line', { class: 'h-4 w-4' })
                  Editar
                </a>

                @let(excluirForm = formAttributes('exemplares.destroy', { id: exemplar.id }))
                <form
                  action="{{ excluirForm.action }}"
                  method="{{ excluirForm.method }}"
                  onsubmit="return confirm('Excluir o exemplar {{ exemplar.codigo }}?')"
                >
                  {{ csrfField() }}
                  <button
                    type="submit"
                    class="inline-flex cursor-pointer items-center gap-1 font-medium text-red-600 hover:text-red-700"
                  >
                    @svg('lucide:trash-2', { class: 'h-4 w-4' })
                    Excluir
                  </button>
                </form>
              </div>
            </td>
          </tr>
        @else
          <tr>
            <td colspan="5" class="px-4 py-10 text-center text-gray-500">
              Nenhum exemplar encontrado.
            </td>
          </tr>
        @end
      </tbody>
    </table>
  </div>

  @if(exemplares.hasPages)
    <div class="mt-4 flex items-center justify-between text-sm text-gray-600">
      <span>Página {{ exemplares.currentPage }} de {{ exemplares.lastPage }}</span>
      <div class="flex items-center gap-2">
        @if(exemplares.currentPage > 1)
          <a
            href="{{ exemplares.getUrl(exemplares.currentPage - 1) }}"
            class="rounded-md border border-gray-300 px-3 py-1.5 font-medium transition-colors hover:bg-gray-50"
          >
            Anterior
          </a>
        @end
        @if(exemplares.currentPage < exemplares.lastPage)
          <a
            href="{{ exemplares.getUrl(exemplares.currentPage + 1) }}"
            class="rounded-md border border-gray-300 px-3 py-1.5 font-medium transition-colors hover:bg-gray-50"
          >
            Próxima
          </a>
        @end
      </div>
    </div>
  @end
@end
