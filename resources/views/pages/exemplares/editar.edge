@layouts.app({ title: 'Editar exemplar — Archivum', active: 'exemplares' })
  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold text-gray-900">Editar exemplar</h1>
    <p class="mt-1 text-sm text-gray-600">Atualize os dados do exemplar {{ exemplar.codigo }}.</p>

    <div class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      @let(formEditar = formAttributes('exemplares.update', { id: exemplar.id }))
      @!exemplares.form({
        acao: formEditar.action,
        metodo: formEditar.method,
        exemplar: exemplar,
        livros: livros,
      })
    </div>
  </div>
@end
