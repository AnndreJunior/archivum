@layouts.app({ title: 'Cadastrar exemplar — Archivum', active: 'exemplares' })
  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold text-gray-900">Cadastrar exemplar</h1>
    <p class="mt-1 text-sm text-gray-600">
      Registre uma cópia física e selecione o livro ao qual ela pertence.
    </p>

    <div class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      @let(formCriar = formAttributes('exemplares.store'))
      @!exemplares.form({
        acao: formCriar.action,
        metodo: formCriar.method,
        livros: livros,
      })
    </div>
  </div>
@end
