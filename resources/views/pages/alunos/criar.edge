@layouts.app({ title: 'Novo aluno — Archivum', active: 'alunos' })
  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold text-gray-900">Novo aluno</h1>
    <p class="mt-1 text-sm text-gray-600">Cadastre um aluno da biblioteca escolar.</p>

    <div class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      @let(formCriar = formAttributes('alunos.store'))
      @!alunos.form({ acao: formCriar.action, metodo: formCriar.method })
    </div>
  </div>
@end
