@layouts.app({ title: 'Editar bibliotecário — Archivum', active: 'bibliotecarios' })
  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold text-gray-900">Editar bibliotecário</h1>
    <p class="mt-1 text-sm text-gray-600">Atualize os dados de {{ bibliotecario.nome }}.</p>

    <div class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      @let(formEditar = formAttributes('bibliotecarios.update', { id: bibliotecario.id }))
      @!bibliotecarios.form({
        acao: formEditar.action,
        metodo: formEditar.method,
        bibliotecario: bibliotecario,
      })
    </div>
  </div>
@end
