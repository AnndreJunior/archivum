@layouts.app({ title: 'Novo bibliotecário — Archivum', active: 'bibliotecarios' })
  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold text-gray-900">Novo bibliotecário</h1>
    <p class="mt-1 text-sm text-gray-600">
      Cadastre um usuário que poderá operar o sistema da biblioteca.
    </p>

    <div
      class="mt-4 flex items-start gap-3 rounded-md border border-blue-200 bg-blue-50 p-3 text-sm text-blue-700"
    >
      @svg('lucide:info', { class: 'mt-0.5 h-4 w-4 shrink-0' })
      <span>
        Nenhuma senha é definida aqui. O bibliotecário define a própria senha pelo link
        "Esqueci minha senha" na tela de login.
      </span>
    </div>

    <div class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      @let(formCriar = formAttributes('bibliotecarios.store'))
      @!bibliotecarios.form({ acao: formCriar.action, metodo: formCriar.method })
    </div>
  </div>
@end
