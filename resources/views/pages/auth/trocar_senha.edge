@layouts.auth({ title: 'Trocar senha — Archivum' })
  <div class="w-full max-w-md">
    <div class="rounded-xl border border-gray-200 bg-white p-8 shadow-sm">
      <div class="text-center">
        <span
          class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-brand/10 text-brand"
        >
          @svg('lucide:lock-keyhole', { class: 'h-6 w-6' })
        </span>
        <h1 class="mt-4 text-2xl font-bold text-gray-900">Definir nova senha</h1>
        <p class="mt-1 text-sm text-gray-600">Escolha uma nova senha para a sua conta.</p>
      </div>

      @flashMessage('recuperacaoError')
        <div
          class="mt-6 flex items-start gap-3 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700"
        >
          @svg('lucide:circle-alert', { class: 'mt-0.5 h-4 w-4 shrink-0' })
          <span>{{ $message }}</span>
        </div>
      @end

      <form action="{{ route('auth.trocar_senha.atualizar') }}" method="post" class="mt-6 space-y-4">
        {{ csrfField() }}
        <input type="hidden" name="token" value="{{ token }}" />

        <div>
          <label for="senha" class="block text-sm font-medium text-gray-900">Nova senha</label>
          <input
            type="password"
            id="senha"
            name="senha"
            autocomplete="new-password"
            required
            autofocus
            class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/30"
          />
          @inputError('senha')
            @each(message in $messages)
              <p class="mt-1 text-sm text-red-600">{{ message }}</p>
            @end
          @end
        </div>

        <div>
          <label for="senhaConfirmation" class="block text-sm font-medium text-gray-900">
            Confirme a nova senha
          </label>
          <input
            type="password"
            id="senhaConfirmation"
            name="senhaConfirmation"
            autocomplete="new-password"
            required
            class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/30"
          />
          @inputError('senhaConfirmation')
            @each(message in $messages)
              <p class="mt-1 text-sm text-red-600">{{ message }}</p>
            @end
          @end
        </div>

        <button
          type="submit"
          class="flex w-full items-center justify-center gap-2 rounded-md bg-brand px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand/90"
        >
          @svg('lucide:check', { class: 'h-4 w-4' })
          Salvar nova senha
        </button>
      </form>
    </div>
  </div>
@end
