@layouts.app({ title: 'Novo autor — Archivum' })
  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold text-gray-900">Novo autor</h1>
    <p class="mt-1 text-sm text-gray-600">
      Cadastre um autor para associá-lo às obras do acervo.
    </p>

    @flashMessage('sucesso')
      <div
        class="mt-6 flex items-start gap-3 rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-700"
      >
        @svg('lucide:circle-check', { class: 'mt-0.5 h-4 w-4 shrink-0' })
        <span>{{ $message }}</span>
      </div>
    @end

    <div class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      @let(formAutor = formAttributes('autores.store'))

      <form action="{{ formAutor.action }}" method="{{ formAutor.method }}" class="space-y-5">
        {{ csrfField() }}

        <div>
          <label for="nome" class="block text-sm font-medium text-gray-900">Nome</label>
          <input
            type="text"
            id="nome"
            name="nome"
            value="{{ old('nome', '') }}"
            maxlength="120"
            required
            autofocus
            class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm outline-none focus:border-brand focus:ring-2 focus:ring-brand/30"
          />
          @inputError('nome')
            @each(message in $messages)
              <p class="mt-1 text-sm text-red-600">{{ message }}</p>
            @end
          @end
        </div>

        <div class="flex items-center gap-3 pt-2">
          <button
            type="submit"
            class="inline-flex items-center gap-2 rounded-md bg-brand px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand/90"
          >
            @svg('lucide:check', { class: 'h-4 w-4' })
            Salvar
          </button>
          <a
            href="{{ route('home') }}"
            class="text-sm font-medium text-gray-600 hover:text-gray-900"
          >
            Cancelar
          </a>
        </div>
      </form>
    </div>
  </div>
@end
